# Copy to .env.local for local work. In production these are set on the
# Cloudflare Worker (mg-animation → Settings → Variables and secrets) and
# picked up by the build there.
#
# All values here are PUBLIC: this is a static export, so anything
# prefixed NEXT_PUBLIC_ is compiled into the JavaScript visitors download.

# REQUIRED. The Web3Forms access key for Matt's inbox. Without it the
# form refuses to send and tells the visitor to call instead.
# Runbook: docs/WEB3FORMS-SETUP.md
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional. Only set this to send the form somewhere other than
# Web3Forms. Defaults to https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional. The Plausible analytics domain, e.g. mattjyguidry.tv. Empty
# means no analytics and no cookie banner. Switching it on needs the
# privacy policy's analytics paragraph to match (it does so on its own).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
